#!/usr/bin/env python3
"""Corre cada minuto en la Pi: sincroniza con la API (baja lo que falta, playlist.m3u) y aplica el horario.
Config en /etc/tv-sync.conf (o $TV_SYNC_CONF): líneas URL=... y TOKEN=...; opcional DIR=... (default: $HOME)."""
import datetime, hashlib, json, os, pathlib, subprocess, sys, time, urllib.request

CONF = os.environ.get("TV_SYNC_CONF", "/etc/tv-sync.conf")
if not os.path.exists(CONF):
    sys.exit(0)  # todavía sin configurar: nada que hacer (y sin ruido en el journal)
conf = dict(l.strip().split("=", 1) for l in open(CONF) if "=" in l)
URL, DIR = conf["URL"], pathlib.Path(conf.get("DIR") or pathlib.Path.home())
MEDIA, M3U, CACHE, LAST, CMD, RETRY = DIR / "media", DIR / "playlist.m3u", DIR / "schedule.json", DIR / "schedule.last", DIR / "command.last", DIR / "download.retry"


def api(path):
    return urllib.request.urlopen(urllib.request.Request(URL + path, headers={"Authorization": "Bearer " + conf["TOKEN"]}), timeout=60)


def command(state):
    """Órdenes desde la UI (on / off / console). Una orden se ejecuta una sola vez y solo si es reciente."""
    c = state.get("command")
    if not c or (CMD.exists() and CMD.read_text() == c["id"]):
        return
    CMD.write_text(c["id"])  # antes de ejecutar: no se repite aunque falle
    if time.time() - c["at"] < 300:  # ponytail: asume relojes sincronizados (NTP); una orden vieja de cuando la Pi estaba apagada no se ejecuta
        subprocess.run(["tv-console"] if c["cmd"] == "console" else ["tv", c["cmd"]])


def sync():
    try:
        state = json.load(api("/state"))
    except OSError:
        return  # sin red: seguimos con lo que hay
    if state.get("schedule"):  # primero el horario, así anda aunque falle una descarga
        CACHE.write_text(json.dumps(state["schedule"]))
    else:
        CACHE.unlink(missing_ok=True)
    command(state)
    MEDIA.mkdir(exist_ok=True)
    files = []
    for sha in state["playlist"]:
        f = MEDIA / state["media"][sha]["file"]
        if not f.exists():
            # Tras un fallo de descarga, esperar 10 min: sin esto un archivo roto se baja entero cada 15 s (egress = plata en Railway).
            if RETRY.exists() and time.time() < float(RETRY.read_text()):
                return
            tmp, h = f.with_suffix(f.suffix + ".tmp"), hashlib.sha256()
            try:
                with api("/media/" + sha) as r, open(tmp, "wb") as o:
                    while chunk := r.read(1 << 20):
                        h.update(chunk); o.write(chunk)
                if h.hexdigest() != sha:
                    raise RuntimeError(f"sha incorrecto para {sha}")
            except Exception:
                RETRY.write_text(str(time.time() + 600))
                tmp.unlink(missing_ok=True)
                raise
            tmp.rename(f)
        files.append(f)
    RETRY.unlink(missing_ok=True)  # todo bajado
    for old in MEDIA.iterdir():
        if old not in files:
            old.unlink()
    m3u = "".join(f"{f}\n" for f in files)
    if not M3U.exists() or M3U.read_text() != m3u:
        M3U.with_suffix(".tmp").write_text(m3u)
        M3U.with_suffix(".tmp").replace(M3U)
        subprocess.run(["systemctl", "try-restart", "tv-video"])


def schedule():
    """Actúa solo en los cambios (así un `tv on/off` manual dura hasta el próximo cambio). Usa la hora local de la Pi."""
    if not CACHE.exists():
        return LAST.unlink(missing_ok=True)
    s, now = json.loads(CACHE.read_text()), os.environ.get("TV_NOW") or datetime.datetime.now().strftime("%H:%M")
    on = s["on"] <= now < s["off"] if s["on"] < s["off"] else now >= s["on"] or now < s["off"]
    want = "on" if on else "off"
    if (LAST.read_text() if LAST.exists() else None) != want and subprocess.run(["tv", want]).returncode == 0:
        LAST.write_text(want)  # si tv falla (CEC no listo) no se anota y reintenta al minuto


def report():
    """Le cuenta a la API cómo está la tele (la UI lo muestra)."""
    try:
        tv = subprocess.run(["tv", "status"], capture_output=True, text=True, timeout=20).stdout.strip() or "unknown"
    except (OSError, subprocess.SubprocessError):
        tv = "unknown"
    video = subprocess.run(["systemctl", "is-active", "--quiet", "tv-video"]).returncode == 0
    req = urllib.request.Request(URL + "/status", json.dumps({"tv": tv, "video": video}).encode(), {"Authorization": "Bearer " + conf["TOKEN"]})
    try:
        urllib.request.urlopen(req, timeout=10).close()
    except OSError:
        pass  # sin red: la próxima


try:
    sync()
finally:
    schedule()
    report()
